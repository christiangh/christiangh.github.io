---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang, languages } from '../i18n/ui';
import { getLang, stripLocale, useTranslations } from '../i18n/utils';

interface Props {
	class?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const path = stripLocale(Astro.url.pathname);
const codes = Object.keys(languages) as Lang[];
---

<ul aria-label={t('nav.language')} class:list={['flex gap-2', Astro.props.class]}>
	{codes.map((code, index) => (
		<li class="flex gap-2">
			{index > 0 && (
				<span aria-hidden="true" class="text-cocoa">
					/
				</span>
			)}
			<a
				href={getRelativeLocaleUrl(code, path)}
				lang={code}
				hreflang={code}
				aria-current={code === lang ? 'true' : undefined}
				class="text-caramel transition-colors hover:text-gold current:text-vanilla"
			>
				<span aria-hidden="true">{code}</span>
				<span class="sr-only">{languages[code]}</span>
			</a>
		</li>
	))}
</ul>

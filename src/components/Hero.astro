---
import { getLang, useTranslations } from '../i18n/utils';
import Emphasis from './Emphasis.astro';
import Terminal from './Terminal.astro';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section
	id="top"
	class="relative flex min-h-dvh flex-col overflow-hidden bg-cream px-gutter pt-section pb-8 text-ink"
>
	<div class="flex flex-1 flex-wrap items-center justify-between gap-8 lg:gap-16">
		<div class="flex flex-auto items-center justify-center gap-2 md:gap-4 xl:gap-6">
			<span aria-hidden="true" class="flex-none font-display text-brace text-gold">
				{'{'}
			</span>
			<div class="flex flex-col items-center gap-4 text-center md:gap-6 xl:gap-8">
				<h1 class="font-display text-hero">
					<span class="block">Christian</span>
					<em class="block text-accent">García</em>
					<span class="block">Herreras</span>
				</h1>
				<p class="font-display text-2xl tracking-snug">
					<Emphasis text={t('hero.role')} class="text-accent" />
				</p>
			</div>
			<span aria-hidden="true" class="flex-none font-display text-brace text-gold">
				{'}'}
			</span>
		</div>

		<Terminal />
	</div>

	<div class="mt-10 flex flex-col items-start gap-6 border-t-2 border-ink pt-5 md:flex-row md:items-end md:justify-between">
		<p class="text-xl leading-snug font-medium text-pretty">{t('hero.tagline')}</p>
		<a
			href="#projects"
			class="flex flex-none items-center gap-3 rounded-full bg-ink px-6.5 py-4.5 font-mono text-sm text-cream transition-colors hover:bg-vanilla hover:text-ink"
		>
			{t('hero.cta')}
			<span aria-hidden="true">↓</span>
		</a>
	</div>
</section>

---
interface Props {
	side: 'left' | 'right';
}

const { side } = Astro.props;

// Libre Bodoni brace outlines. Unlike a font glyph, the SVG stretches to the height of the text
// next to it, which changes when the role wraps on narrow screens.
const paths = {
	left: 'M265 910Q200 910 160 903Q121 896 100 876Q80 857 73 821Q66 785 66 728V586Q66 515 52 490Q39 464 0 464V447Q39 447 52 421Q66 395 66 325V182Q66 125 73 89Q80 53 100 34Q121 14 160 7Q200 0 265 0V25Q230 25 210 36Q190 48 182 76Q175 104 175 155V328Q175 390 153 418Q131 446 73 453V457Q131 464 153 492Q175 521 175 583V755Q175 805 182 834Q190 862 210 874Q230 885 265 885Z',
	right: 'M0 910V885Q36 885 56 874Q75 862 82 834Q90 805 90 755V583Q90 521 112 492Q134 464 192 457V453Q134 446 112 418Q90 390 90 328V155Q90 104 82 76Q75 48 56 36Q36 25 0 25V0Q65 0 104 7Q144 14 164 34Q185 53 192 89Q199 125 199 182V325Q199 395 212 421Q226 447 265 447V464Q226 464 212 490Q199 515 199 586V728Q199 785 192 821Q185 857 164 876Q144 896 104 903Q65 910 0 910Z',
};
---

<svg
	aria-hidden="true"
	viewBox="0 0 265 910"
	preserveAspectRatio="none"
	class="w-brace flex-none fill-gold"
>
	<path d={paths[side]} />
</svg>

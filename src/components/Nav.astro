---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, useTranslations } from '../i18n/utils';
import { stripEmphasis } from '../lib/emphasis';
import { sections } from '../lib/sections';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang);
---

<header class="fixed inset-x-0 top-0 z-50 bg-ink/86 font-mono text-xs text-cream backdrop-blur-md">
	<nav
		aria-label={t('nav.label')}
		class="flex items-center justify-between gap-4 px-gutter py-3.5"
	>
		<a href={`${home}#top`} class="font-bold tracking-wide">
			<span class="text-vanilla">~/</span>christiangh
		</a>

		<ol class="hidden gap-6 md:flex lg:gap-8">
			{sections.map((id, index) => (
				<li>
					<a href={`${home}#${id}`} class="lowercase transition-colors hover:text-gold">
						<span aria-hidden="true">{String(index + 1).padStart(2, '0')} </span>
						{stripEmphasis(t(`section.${id}.title`))}
					</a>
				</li>
			))}
		</ol>
	</nav>
</header>
